# User quadlet for the scratch image from scripts/build-sitrep.sh.
# Copy to ~/.config/containers/systemd/sitrep.container.
# Put the checklist tree at ~/sitrep/completed_ckl, or change the Volume line.
# Copy config/console.env to ~/sitrep/console.env and set CHECKLIST_DOMAIN there.
[Container]
Image=localhost/sitrep:latest
ContainerName=sitrep
PublishPort=8787:8780
Environment=CHECKLIST_ROOT=/data
EnvironmentFile=%h/sitrep/console.env
Volume=%h/sitrep/completed_ckl:/data:ro,Z
Volume=/etc/localtime:/host/localtime:ro

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
