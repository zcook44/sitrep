# Settings for Sitrep.
# install-sitrep.sh copies this file to /etc/sitrep/console.env on the first run
# and leaves later edits in place. The quadlet reads ~/sitrep/console.env.
# Lines starting with # are ignored.

# Checklist tree inside the container. The host directory is mounted on /data.
CHECKLIST_ROOT=/data

# Header name when the network has no DNS domain. The systemd unit does not
# mount the system bus, so set this on a host install.
# CHECKLIST_DOMAIN=site.example.mil
